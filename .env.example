DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
CORS_ALLOWED_ORIGINS=http://localhost:5173
DATABASE_URL=postgresql://claims:claims@db:5432/claims
N8N_WEBHOOK_URL=http://n8n:5678/webhook/process-claim
N8N_CALLBACK_TOKEN=local-demo-token
VITE_API_URL=http://localhost:8000/api
OLLAMA_ENABLED=true
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_DOCUMENT_MODEL=qwen2.5:3b
OLLAMA_VISION_MODEL=llava:7b
OLLAMA_POLICY_MODEL=qwen2.5:3b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text:latest
AI_REQUEST_TIMEOUT=180
WHISPER_ENABLED=true
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=fr
WHISPER_MODEL_CACHE=/models/faster-whisper

# Email automatique envoyé au responsable lors de la transmission d'un dossier.
