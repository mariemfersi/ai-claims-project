EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=ineschtioui42@gmail.com
EMAIL_HOST_PASSWORD=your-gmail-app-password
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
DEFAULT_FROM_EMAIL=ineschtioui42@gmail.com
EMAIL_TIMEOUT=20
EMAIL_MAX_ATTACHMENT_BYTES=20971520
